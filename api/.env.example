APP_NAME="Ant Laravel Admin"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# CORS_ALLOWED_ORIGINS 是带 scheme 的浏览器 Origin 白名单；credentialed CORS 禁止使用 *。
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SANCTUM_STATEFUL_DOMAINS 是不带 scheme 的 host/port 列表，用于 Sanctum SPA Cookie 会话识别。
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=ant_laravel_admin
DB_USERNAME=your_database_username
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_0900_ai_ci

SESSION_DRIVER=redis
SESSION_CONNECTION=default
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# localhost 本地开发保持 SESSION_DOMAIN=null；同站子域部署可使用 .example.com。
SESSION_DOMAIN=null
# HTTPS 生产环境必须设置 SESSION_SECURE_COOKIE=true。
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
# 本地开发和同站子域默认使用 lax；真正跨站如需 none，必须同时启用 Secure Cookie。
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=ant_laravel_admin_cache

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=14
REDIS_CACHE_DB=14
REDIS_QUEUE_CONNECTION=default
REDIS_QUEUE=default

TELESCOPE_ENABLED=false
TELESCOPE_PATH=telescope

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# 新建或修改密码的统一规则；不影响已有密码登录。
FOUNDATION_PASSWORD_MIN_LENGTH=12
FOUNDATION_PASSWORD_MIXED_CASE=true
FOUNDATION_PASSWORD_NUMBERS=true
FOUNDATION_PASSWORD_SYMBOLS=true
